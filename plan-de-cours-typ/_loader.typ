// _loader.typ — pont Markdown → Typst
//
// Source unique de vérité :
//   - métadonnées  → variable_expansion.toml (lu via la fonction `toml()`)
//   - corps        → 00-plan-de-cours/README.md (site Docsify, variables
//                    déjà injectées par `docsh run`)
//
// Usage :
//   #import "_loader.typ": charger_plan
//   #let (meta, body) = charger_plan("../")
//   #show: plan_de_cours.with(..meta)
//   #body

#import "@preview/cmarker:0.1.8": render-with-metadata
#import "_typography.typ": FONT_CORPS, FONT_TITRES

#let _est_deja_chemin(s) = {
  let s = str(s)
  s.starts-with("/") or s.starts-with("./") or s.starts-with("../")
}
#let _est_url(s) = {
  let s = str(s)
  s.starts-with("http://") or s.starts-with("https://")
}

#let _resoudre_url_lien(dest, url_site) = {
  let d = str(dest)
  if _est_url(d) { return d }
  let base = if url_site.ends-with("/") { url_site } else { url_site + "/" }
  if d.starts-with("/") {
    // Site-root-relative → base# + path  (Docsify hash routing)
    return base + "#" + d
  }
  if d.starts-with("../") {
    // ../ from 00-plan-de-cours/ → repo root → base# + path
    return base + "#/" + d.trim("../", at: start)
  }
  if d.starts-with("./") {
    return base + "#/" + d.trim("./", at: start)
  }
  base + "#/" + d
}

// Résout une image/lien relatif(au README) vers un chemin résolvable
// depuis le fichier Typst courant.
#let _resoudre_source(source, base_dir) = {
  let s = str(source)
  if _est_url(s) or _est_deja_chemin(s) { s }
  else { base_dir + "/" + s }
}

#let _retirer_frontmatter(md) = {
  let lines = md.split("\n")
  if lines.len() == 0 or lines.at(0).trim() != "---" { md }
  else {
    let i = 1
    while i < lines.len() and lines.at(i).trim() != "---" { i += 1 }
    if i >= lines.len() { md }
    else {
      i += 1
      if i < lines.len() and lines.at(i).trim() == "" { i += 1 }
      lines.slice(i).join("\n")
    }
  }
}

#let _strip_docsh_tags(md) = {
  // Blocs remplaçables : <!-- start-replace-X --> ... <!-- end-replace-X -->
  let md = md.replace(regex("\\<\\!--\\s*start-replace-[\\s\\S]*?end-replace-[\\s\\S]*?--\\>"), "")
  let md = md.replace(regex("\\<\\!--\\s*start-replace-[^\n]*--\\>"), "")
  let md = md.replace(regex("\\<\\!--\\s*end-replace-[^\n]*--\\>"), "")
  // Marqueurs de variables : on garde la valeur injectée, on retire les balises
  let md = md.replace(regex("\\<\\!--\\s*%:\\s*[^\\s>]+\\s*--\\>"), "")
  let md = md.replace(regex("\\<\\!--\\s*%;\\s*--\\>"), "")
  // Commentaires "Generated by docsh"
  let md = md.replace(regex("\\<\\!--\\s*Generated by docsh[^\n]*--\\>"), "")
  md
}

#let _injecter_directives_typst(md) = {
  // Depuis le Markdown, on peut demander à Typst de faire un saut de page :
  //   <!-- typst:pagebreak -->   ou   <typst-pagebreak/>
  let s = str(md)
  s = s.replace(regex("<!--\\s*typst:pagebreak\\s*-->"), "\n<typstpagebreak></typstpagebreak>\n")
  s = s.replace(regex("<\\s*/?\\s*typst-pagebreak\\s*/?\\s*>"), "<typstpagebreak></typstpagebreak>")
  s
}

#let _convertir_callouts(md) = {
  // GitHub-style alerts :  > [!NOTE]  …  →  <callout type="note">…</callout>
  // (cmarker ne gère pas ces alertes ; on les transforme en élément HTML
  //  « raw-text » que l'on ré-enveloppe nous-mêmes dans _boite_appel.)
  let lignes = md.split("\n")
  let n = lignes.len()
  let sorts = ()
  let i = 0
  while i < n {
    let ligne = lignes.at(i)
    let m = ligne.match(regex("^>\\s*\\[!\\s*(NOTE|TIP|WARNING|IMPORTANT|CAUTION)\\s*\\]\\s*(.*)$"))
    if m != none {
      let type_appel = lower(m.captures.at(0).trim())
      let premiere = m.captures.at(1)
      let interne = ()
      if premiere.trim() != "" { interne.push(premiere) }
      i += 1
      while i < n and lignes.at(i).trim().starts-with(">") {
        let l = lignes.at(i)
        let contenu = if l.len() >= 2 and l.at(1) == " " { l.slice(2) }
                      else if l.len() >= 1 and l.at(0) == ">" { l.slice(1) }
                      else { l }
        interne.push(contenu)
        i += 1
      }
      let corps = interne.join("\n")
      sorts.push("<callout type=\"" + type_appel + "\">\n" + corps + "\n</callout>")
    } else {
      sorts.push(ligne)
      i += 1
    }
  }
  sorts.join("\n")
}

#let _styles_appel = (
  note: (couleur: rgb("#002768"), titre: "Note"),
  tip: (couleur: rgb("#1a7f37"), titre: "Astuce"),
  warning: (couleur: rgb("#9a6700"), titre: "Avertissement"),
  important: (couleur: rgb("#9a6700"), titre: "Important"),
  caution: (couleur: rgb("#b42318"), titre: "Attention"),
)

#let _boite_appel(attrs, corps_md, base_dir, url_site) = {
  let type_appel = lower(attrs.at("type", default: "note"))
  let style = _styles_appel.at(type_appel, default: _styles_appel.at("note"))
  let net = str(corps_md).trim().replace(regex("(?i)</callout>\\s*$"), "").trim()
    let (_, contenu) = render-with-metadata(
    net,
    metadata-block: none,
    html: (typstpagebreak: (_, _) => pagebreak()),
    scope: (
      image: (source, alt: none, format: auto) => image(
        _resoudre_source(source, base_dir), alt: alt, format: format,
      ),
      link: (dest, body) => {
        let d = _resoudre_url_lien(dest, url_site)
        link(d)[#underline(stroke: blue)[#text(fill: blue)[#body]]]
      },
    ),
  )
  block(
    breakable: true,
    inset: (left: 0.9em, right: 0.7em, top: 0.55em, bottom: 0.55em),
    stroke: (left: 3pt + style.couleur),
    fill: style.couleur.lighten(90%),
  )[
    #set text(font: FONT_CORPS, size: 1em, weight: "regular", fill: black)
    #contenu
  ]
}

#let _cartes_html(base_dir, url_site) = (
  typstpagebreak: (_, _) => pagebreak(),
  callout: ("raw-text", (attrs, corps) => _boite_appel(attrs, corps, base_dir, url_site)),
)

#let _rendre_markdown(md, base_dir: "", url_site: "") = {
  let md2 = _injecter_directives_typst(_convertir_callouts(_strip_docsh_tags(md)))
  let (_, corps) = render-with-metadata(
    md2,
    metadata-block: none,
    html: _cartes_html(base_dir, url_site),
    scope: (
      image: (source, alt: none, format: auto) => image(
        _resoudre_source(source, base_dir), alt: alt, format: format,
      ),
      link: (dest, body) => {
        let d = _resoudre_url_lien(dest, url_site)
        link(d)[#underline(stroke: blue)[#text(fill: blue)[#body]]]
      },
    ),
  )
  {
    set table(stroke: (paint: rgb("#7f93b3")))
    corps
  }
}

#let _retirer_entete_redondant(md) = {
  // Le bloc d'en-tête (H1 + liste de métadonnées) est déjà sur la page
  // couverture. S'il est présent, on le retire du corps pour éviter la
  // redondance (jusqu'au premier titre de section « ## »).
  let lines = md.split("\n")
  let limite = if lines.len() < 80 { lines.len() } else { 80 }
  let debut = lines.slice(0, limite).join("\n")
  let redondant = debut.contains("Numéro de cours") or debut.contains("Pondération") or debut.contains("Professeur")
  if not redondant { md }
  else {
    let idx = range(0, lines.len())
      .filter(i => lines.at(i).trim().starts-with("## "))
      .at(0, default: none)
    if idx == none { md } else { lines.slice(idx).join("\n") }
  }
}

#let charger_plan(parent: "../") = {
  // 1. Métadonnées depuis le fichier TOML (source unique de vérité)
  //    Même nom que celui détecté par docsh (variable_expansion.toml, visible
  //    ou caché ; ici on privilégie le nom visible).
  let d = toml(parent + "variable_expansion.toml")
  let url_site = d.at("URL_SITE", default: "")
  let meta = (
    numero_cours: d.at("NUMERO_COURS", default: "582 XXX MO"),
    titre: d.at("TITRE", default: "Nom du cours"),
    heures: d.at("HEURES", default: ""),
    ponderation: d.at("PONDERATION", default: ""),
    programme: d.at("PROGRAMME", default: "Techniques d’intégration multimédia"),
    // Cours complémentaire : DEPARTEMENT_COUVERTURE = false masque la
    // ligne « Département du programme » de la couverture (le corps du
    // plan, lui, continue d'afficher la clé DEPARTEMENT).
    departement_programme: if d.at("DEPARTEMENT_COUVERTURE", default: true) {
      d.at("DEPARTEMENT", default: none)
    } else {
      none
    },
    departement_prof: d.at("DEPARTEMENT_PROFS", default: none),
    session: d.at("SESSION", default: ""),
    date_desinscription: d.at("DATE_DESINSCRIPTION", default: none),
    date_desinscription_libelle: d.at("DATE_DESINSCRIPTION_LIBELLE", default: none),
    date_abandon: d.at("DATE_ABANDON", default: none),
    date_abandon_libelle: d.at("DATE_ABANDON_LIBELLE", default: none),
    profs: d.at("PROFS", default: none),
    courriel: d.at("COURRIEL", default: none),
    bureau: d.at("BUREAU", default: none),
    professeurs: d.at("PROFESSEURS", default: none),
    plateformes: d.at("PLATEFORMES", default: none),
    coordination_nom: d.at("COORDINATION_NOM", default: none),
    coordination_courriel: d.at("COORDINATION_COURRIEL", default: none),
    coordination_bureau: d.at("COORDINATION_BUREAU", default: none),
  )

  // 2. Corps depuis le README Docsify (variables déjà injectées)
  let md = read(parent + "00-plan-de-cours/README.md")
  let md_sans_fm = _retirer_frontmatter(md)
  let md_corps = _retirer_entete_redondant(md_sans_fm)
  let body = _rendre_markdown(md_corps, base_dir: parent + "00-plan-de-cours", url_site: url_site)

  (meta, body)
}
